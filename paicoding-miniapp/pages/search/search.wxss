.search-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #fff;
}

/* 顶部搜索框 */
.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  margin-bottom: 18rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.search-input__inner {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f7f9fa !important;
}

.search-input__field {
  font-size: 28rpx;
}

.search-button {
  flex-shrink: 0;
}

/* 通用分区(历史 / 热门) */
.history-panel {
  margin-bottom: 18rpx;
  padding: 24rpx 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: #ABB6C2;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.section-action {
  color: #ABB6C2;
  font-size: 24rpx;
  line-height: 34rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  height: 64rpx;
  padding: 0rpx 30rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  overflow: hidden;
}

.tag-chip--ghost {
  background: #f7f9fa;
  color: #334155;
}

.tag-chip--hover {
  background: #f1f5f9;
}

/* 结果区 */
.result-scroll {
  flex: 1;
  height: calc(100vh - 140rpx);
  padding: 30rpx;
}

.result-scroll--has-data {
  background-color: #f7f9fa;
}

.state-card {
  padding: 80rpx 28rpx;
  text-align: center;
}

.state-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

.retry-button {
  margin-top: 28rpx;
}

.load-state {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.loading-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0bc196;
  animation: search-bounce 1s infinite ease-in-out;
}

.loading-dots .dot:nth-child(2) {
  animation-delay: 0.15s;
}

.loading-dots .dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes search-bounce {

  0%,
  80%,
  100% {
    transform: scale(0.6);
    opacity: 0.5;
  }

  40% {
    transform: scale(1);
    opacity: 1;
  }
}